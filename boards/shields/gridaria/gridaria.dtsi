#include <dt-bindings/zmk/matrix_transform.h>
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <dt-bindings/led/led.h>
#include <zephyr/dt-bindings/adc/adc.h>
#include <zephyr/dt-bindings/adc/nrf-saadc.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <physical_layouts.dtsi>

/ {
  chosen {
    zmk,kscan = &kscan0;
    transform = <&default_transform>;
    zmk,physical-layout = &gridaria_default_layout;
    zmk,underglow = &led_strip;
  };

  kscan0: kscan {
    compatible = "zmk,kscan-gpio-duplex";
    row-gpios = <&xiao_d 10 GPIO_ACTIVE_LOW>,
                <&xiao_d 1 GPIO_ACTIVE_LOW>,
                <&xiao_d 2 GPIO_ACTIVE_LOW>,
                <&xiao_d 3 GPIO_ACTIVE_LOW>;
    col-gpios = <&xiao_d 4 GPIO_ACTIVE_LOW>,
                <&xiao_d 5 GPIO_ACTIVE_LOW>,
                <&xiao_d 6 GPIO_ACTIVE_LOW>,
                <&xiao_d 9 GPIO_ACTIVE_LOW>,
                <&xiao_d 8 GPIO_ACTIVE_LOW>;
    debounce-press-ms = <5>;
    debounce-release-ms = <5>;
    poll-period-ms = <1>;
  };

  default_transform: matrix_transform {
    compatible = "zmk,matrix-transform";
    rows = <4>;
    columns = <10>;
    map = <
      RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9)
      RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9)
      RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9)
      RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,5) RC(3,7) RC(3,8) RC(3,9)
    >;
  };

  gridaria_default_layout: gridaria_default_layout {
    compatible = "zmk,physical-layout";
    display-name = "Gridaria";
    transform = <&default_transform>;
    kscan = <&kscan0>;
    keys
      = <&key_physical_attrs 100 100    0   0 0 0 0>
      , <&key_physical_attrs 100 100  100   0 0 0 0>
      , <&key_physical_attrs 100 100  200   0 0 0 0>
      , <&key_physical_attrs 100 100  300   0 0 0 0>
      , <&key_physical_attrs 100 100  400   0 0 0 0>
      , <&key_physical_attrs 100 100  800   0 0 0 0>
      , <&key_physical_attrs 100 100  900   0 0 0 0>
      , <&key_physical_attrs 100 100 1000   0 0 0 0>
      , <&key_physical_attrs 100 100 1100   0 0 0 0>
      , <&key_physical_attrs 100 100 1200   0 0 0 0>
      , <&key_physical_attrs 100 100    0 100 0 0 0>
      , <&key_physical_attrs 100 100  100 100 0 0 0>
      , <&key_physical_attrs 100 100  200 100 0 0 0>
      , <&key_physical_attrs 100 100  300 100 0 0 0>
      , <&key_physical_attrs 100 100  400 100 0 0 0>
      , <&key_physical_attrs 100 100  800 100 0 0 0>
      , <&key_physical_attrs 100 100  900 100 0 0 0>
      , <&key_physical_attrs 100 100 1000 100 0 0 0>
      , <&key_physical_attrs 100 100 1100 100 0 0 0>
      , <&key_physical_attrs 100 100 1200 100 0 0 0>
      , <&key_physical_attrs 100 100    0 200 0 0 0>
      , <&key_physical_attrs 100 100  100 200 0 0 0>
      , <&key_physical_attrs 100 100  200 200 0 0 0>
      , <&key_physical_attrs 100 100  300 200 0 0 0>
      , <&key_physical_attrs 100 100  400 200 0 0 0>
      , <&key_physical_attrs 100 100  800 200 0 0 0>
      , <&key_physical_attrs 100 100  900 200 0 0 0>
      , <&key_physical_attrs 100 100 1000 200 0 0 0>
      , <&key_physical_attrs 100 100 1100 200 0 0 0>
      , <&key_physical_attrs 100 100 1200 200 0 0 0>
      , <&key_physical_attrs 100 100    0 300 0 0 0>
      , <&key_physical_attrs 100 100  100 300 0 0 0>
      , <&key_physical_attrs 100 100  200 300 0 0 0>
      , <&key_physical_attrs 200 100  300 300 0 0 0>
      , <&key_physical_attrs 200 100  800 300 0 0 0>
      , <&key_physical_attrs 100 100 1000 300 0 0 0>
      , <&key_physical_attrs 100 100 1100 300 0 0 0>
      , <&key_physical_attrs 100 100 1200 300 0 0 0>
      ;
  };

  fader: analog_axis_hires {
    compatible = "analog-axis-hires";
    status = "okay";
    poll-period-ms = <8>;

    axis-x {
      io-channels = <&adc 0>;
      in-min = <0>;
      in-max = <4095>;
      /* Keep zero positions observable; the driver suppresses unchanged zero values. */
      out-min = <1>;
      out-max = <1024>;
      zephyr,axis-type = <INPUT_EV_ABS>;
      zephyr,axis = <INPUT_ABS_X>;
    };
  };
};

&adc {
  status = "okay";

  #address-cells = <1>;
  #size-cells = <0>;

  channel@0 {
    reg = <0>;
    zephyr,resolution = <12>;
    zephyr,gain = "ADC_GAIN_1_4";
    zephyr,reference = "ADC_REF_VDD_1_4";
    zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
    zephyr,input-positive = <NRF_SAADC_AIN0>;
  };
};

&uicr {
  nfct-pins-as-gpios;
};

&pinctrl {
    spi3_default: spi3_default {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 1, 12)>;
        };
    };

    spi3_sleep: spi3_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 1, 12)>;
            low-power-enable;
        };
    };
};

&spi3 {
    compatible = "nordic,nrf-spim";
    status = "okay";

    pinctrl-0 = <&spi3_default>;
    pinctrl-1 = <&spi3_sleep>;
    pinctrl-names = "default", "sleep";

    led_strip: ws2812@0 {
        compatible = "worldsemi,ws2812-spi";

        reg = <0>;
        spi-max-frequency = <4000000>;
        chain-length = <7>;
        spi-one-frame = <0x70>;
        spi-zero-frame = <0x40>;
        color-mapping = <LED_COLOR_ID_GREEN
                         LED_COLOR_ID_RED
                         LED_COLOR_ID_BLUE>;
    };
};